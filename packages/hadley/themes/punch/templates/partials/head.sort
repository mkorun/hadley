<head>
  <meta charset="{ meta.charset }">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="hadley">
  <title>{ htmlTitle }</title>
  <link rel="icon" href="{ assets['/favicon.svg'] }" type="image/svg+xml">
  {#if meta.description}<meta name="description" content="{ meta.description }">{:else if urlPath === '/'}<meta name="description" content="{ site.description }">{/if}
  {#if meta.noindex}<meta name="robots" content="noindex">{/if}
  <link rel="canonical" href="{ canonicalUrl }">
  {#if cover}<meta data-pagefind-meta="image[content]" content="{ cover.src }">{/if}
  {#each translations as url, lang}<link rel="alternate" hreflang="{ lang }" href="{ site.origin }{ url }">
  {/each}
  {#if site.theme.colorToggle || hasTranslations}<script src="{ assets['/assets/js/reader.js'] }"></script>{/if}
  <script src="{ assets['/assets/js/transitions.js'] }"></script>
  {#if template === 'home'}<link rel="expect" href="#colophon" blocking="render">{/if}

  <link rel="preload" href="{ assets['/assets/fonts/fraunces-latin-wght-normal.woff2'] }" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{ assets['/assets/css/style.css'] }">
  {#if hasCode}<link rel="stylesheet" href="{ assets['/assets/css/syntax-highlighting.css'] }">{/if}
  {#if feed}<link rel="alternate" type="application/rss+xml" title="{ site.title }" href="{ feed.url }">{/if}

  <meta property="og:title" content="{ htmlTitle }">
  <meta property="og:site_name" content="{ site.title }">
  <meta property="og:url" content="{ canonicalUrl }">
  {#if site.locale}<meta property="og:locale" content="{ site.locale }">{/if}
  {#if isArticle}
  <meta property="og:type" content="article">
  {#if meta.publishFrom}<meta property="article:published_time" content="{ meta.publishFrom | isoDate }">{/if}
  {#if meta.updatedAt}<meta property="article:modified_time" content="{ meta.updatedAt | isoDate }">{/if}
  {:else}
  <meta property="og:type" content="website">
  {/if}
  {#if meta.description}<meta property="og:description" content="{ meta.description }">{:else if urlPath === '/'}<meta property="og:description" content="{ site.description }">{/if}
  {#if ogImage}<meta property="og:image" content="{ ogImage }">{/if}

  {@raw html.jsonLd}
</head>
