{#if site.ownerLinks && site.ownerLinks.profiles.length > 0}
<ul class="profiles" aria-label="{ t.profiles.label }">
  {#each site.ownerLinks.profiles as profile}
  <li><a href="{ profile.url }" rel="me" title="{ profile.label }">{@render icon(profile.network)}<span class="visually-hidden">{ profile.label }</span></a></li>
  {/each}
</ul>
{/if}
