{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "semi": false,
  "sortPackageJson": false,
  "ignorePatterns": ["packages/hadley/starters/*/content/**", "docs/**/*.md", "README.md"]
}
